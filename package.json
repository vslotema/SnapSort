{
  "name": "snapsort",
  "version": "0.1.0",
  "description": "AI-powered file organizer with non-destructive preview",
  "main": "app/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electronmon app/main/index.js\"",
    "ai:dev": "ai-service/venv/bin/uvicorn main:app --app-dir ai-service --host 127.0.0.1 --port 8000 --reload",
    "dev:all": "concurrently -k \"npm run ai:dev\" \"npm run dev\"",
    "build": "vite build && electron-builder"
  },

  "keywords": [
    "electron",
    "vue",
    "ai",
    "file-organizer"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^latest",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^4.0.0",
    "vite": "^5.0.0",
    "wait-on": "^latest"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "mime-types": "^2.1.35",
    "pinia": "^2.1.7",
    "sql.js": "^1.10.3",
    "vue": "^3.4.0",
    "vue-feather": "^2.0.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.5.0"
  }
}
